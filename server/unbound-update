        unhold()
        closed = firewall_close()
    say("OS 標準 unbound の除外を外しました。" + (f"この仕組みが開けた {closed} の許可も閉じました。" if closed else ""))
    say("導入済みの unbound のパッケージと設定は、そのまま残しています。")
    say(f"このコマンドと記録を消すには: rm -rf {ETC_DIR} {STATE_DIR} {os.path.realpath(__file__)}")
    return 0


def cmd_init(args):
    if not REPO_RE.match(args.repository):
        raise Fatal("--repository は「所有者/リポジトリ名」の形で指定してください。")
    if os.path.exists(CONFIG_PATH):
        raise Fatal(f"設定ファイルはすでにあります: {CONFIG_PATH}")
    os.makedirs(ETC_DIR, mode=0o755, exist_ok=True)
    with open(CONFIG_PATH, "w", encoding="utf-8") as handle:
        handle.write(CONFIG_TEMPLATE.replace("@REPOSITORY@", args.repository))
    say(f"設定ファイルを作りました: {CONFIG_PATH}")
    return 0


def make_parser():
    parser = argparse.ArgumentParser(prog=TOOL_NAME, description="Unbound のパッケージを取得し、照合して入れ替えます。")
    sub = parser.add_subparsers(dest="command", metavar="コマンド")
    item = sub.add_parser("update", help="公開されている版へ入れ替える（既定は最新）")
    item.add_argument("--version", help="上流の版（例 1.26.2）")
    item.add_argument("--tag", help="リリースのタグ（例 v1.26.2-1）")
    item.add_argument("--force", action="store_true", help="同じ版でも入れ直す")
    item.set_defaults(func=cmd_update)
    sub.add_parser("check", help="導入済みの版と、公開されている最新版を表示する").set_defaults(func=cmd_check)
    sub.add_parser("verify", help="状態と名前解決を確かめる").set_defaults(func=cmd_verify)
    sub.add_parser("rollback", help="直前の版へ戻す（設定は変えない）").set_defaults(func=cmd_rollback)
    item = sub.add_parser("save", help="現在の設定を 1 ファイルに保存する（旧サーバーで使う）")
    item.add_argument("--output", required=True)
    item.add_argument("--config-dir", default="")
    item.set_defaults(func=cmd_save)
    item = sub.add_parser("migrate", help="初回の導入、設定の復元、OS 標準 unbound の除外、ファイアウォール")
    item.add_argument("--config", help="save で保存したファイル")
    item.add_argument("--version")
    item.add_argument("--tag")
    item.set_defaults(func=cmd_migrate)
    item = sub.add_parser("self-update", help="このコマンド自体を更新する")
    item.add_argument("--target", help=argparse.SUPPRESS)
    item.set_defaults(func=cmd_self_update)
    sub.add_parser("uninstall", help="除外設定とファイアウォールの許可を元に戻す").set_defaults(func=cmd_uninstall)
    item = sub.add_parser("init", help="設定ファイルを作る")
    item.add_argument("--repository", required=True)
    item.set_defaults(func=cmd_init)
    return parser


def main(argv):
    if not argv or argv[0].startswith("--") and argv[0] not in ("-h", "--help"):
        argv = ["update"] + argv
    args = make_parser().parse_args(argv)
    try:
        if not ROOT and os.geteuid() != 0:
            raise Fatal(f"root で実行してください: sudo {TOOL_NAME} {' '.join(argv)}")
        return args.func(args)
    except Fatal as exc:
        print("エラー: " + str(exc), file=sys.stderr, flush=True)
        return exc.code
    except StepError as exc:
        print(f"エラー（{exc.stage}）: {exc.detail}", file=sys.stderr, flush=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
